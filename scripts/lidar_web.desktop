[Desktop Entry]
Type=Application
Name=ToF LiDAR (Web Viewer)
Comment=Networked LiDAR dashboard: 3D point cloud + depth heatmap -- open in a browser
Exec=lxterminal -t "VL53L9CX Web Viewer" -e bash -c "$HOME/vl53l9cx-pi-lidar/run_lidar_web.sh; echo; echo 'Press Enter to close...'; read"
Icon=network-server
Terminal=false
Categories=Utility;
